    "HangfireConnection": "Server=YOUSRY-BAHBAH\\SQLEXPRESS;Database=MASAR_Jobs;Trusted_Connection=True;Encrypt=False"
  },

  "Jwt": {
    "Issuer": "Masar.Api",
    "Audience": "Masar.Client",
