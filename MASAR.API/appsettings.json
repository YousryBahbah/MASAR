        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "Masar"
    }
  },

  "AllowedOrigins": [
    "https://www.masar-app.com"
  ],

  "AllowedHosts": "*"
